# Application
APP_NAME="AI Customer Support Agent"
APP_ENV=development
DEBUG=false

# Model configuration
MODEL_PROVIDER=openrouter
MODEL_NAME=nvidia/nemotron-3.5-super-vl:free
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=0

# Required for the default OpenRouter provider
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME="AI Customer Support Agent"

# Optional alternative providers (set MODEL_PROVIDER to use one)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional web search
TAVILY_API_KEY=

# Optional tracing. Keep disabled until configured.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-customer-support
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Local SQLite storage (directories are created automatically)
DATABASE_PATH=storage/support.db
CHECKPOINT_PATH=storage/checkpoints.sqlite
# SUPPORT_CHECKPOINT_DB_PATH is a legacy override for CHECKPOINT_PATH.
# VECTOR_STORE_PATH is reserved; current retrieval scans knowledge_base files.
