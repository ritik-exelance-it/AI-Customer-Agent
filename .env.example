# Model configuration
MODEL_PROVIDER="openrouter"
MODEL_NAME="nvidia/nemotron-3.5-super-vl:free"

# API keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Web search
TAVILY_API_KEY=

# Enable active tracing (Required)
LANGCHAIN_TRACING_V2=true

# Provide your newly created API key (Required)
# Note: LangChain supports both LANGCHAIN_API_KEY and LANGSMITH_API_KEY formats
LANGCHAIN_API_KEY="lsv2_pt_..."

# Define the endpoint server (Required)
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# The name of the project folder in your LangSmith dashboard (Optional, defaults to 'default')

LANGSMITH_PROJECT=ai-customer-support